# Copy to .env and fill in. NEVER commit .env. Values below are placeholders, not secrets.
# Development credentials are for the LOCAL docker-compose stack only: change them in production.

# --- runtime
# OSINT_CONFIG_DIR=/app/config        # default: <repo>/config (set it in Docker)
OSINT_DEMO_MODE=false                 # true = offline synthetic data, no external calls

# --- PostgreSQL (asyncpg driver)
POSTGRES_USER=osint
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=osint
DATABASE_URL=postgresql+asyncpg://osint:change-me-dev-only@localhost:5432/osint

# --- Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-dev-only

# --- Redis (arq job queue + shared rate limiter)
REDIS_URL=redis://localhost:6379/0

# --- application secrets
# Session signing key: python -c "import secrets; print(secrets.token_urlsafe(48))"
OSINT_SECRET_KEY=
# Fernet key for API keys stored from the UI:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OSINT_ENCRYPTION_KEY=

# --- optional collector API keys (collectors without their key are SKIPPED; demo uses mocks)
OSINT_HIBP_API_KEY=                   # https://haveibeenpwned.com/API/Key (paid)
OSINT_GITHUB_TOKEN=                   # optional, raises GitHub API rate limit
OSINT_MAXMIND_LICENSE_KEY=            # optional, to download GeoLite2 databases

# --- integration tests (optional; tests marked `integration` are skipped when unset)
OSINT_TEST_DATABASE_URL=
OSINT_TEST_NEO4J_URI=
OSINT_TEST_REDIS_URL=

# --- frontend dev server
VITE_API_PROXY_TARGET=http://localhost:8000
